  "knowledge_articles": [
    {
      "id": 1,
      "company_id": null,
      "site_id": null,
      "contact_id": null,
      "asset_id": null,
      "title": "First-response troubleshooting checklist",
      "body": "Confirm who is affected, when the issue began, and whether work is blocked. Record the exact error text—including characters such as < and >—before changing settings.\n\nCheck for a known incident, capture a reproducible example, and note any safe workaround. Escalate when the impact grows or the initial checks do not isolate the cause.\n\nKeep customer updates factual. Do not imply that a fix has been applied until it is verified.",
      "created_at": "2026-09-08T13:00:00Z",
      "updated_at": "2026-09-15T09:00:00Z"
    },
    {
      "id": 2,
      "company_id": 1,
      "site_id": null,
      "contact_id": null,
      "asset_id": null,
      "title": "Northstar remote access handoff",
      "body": "For Northstar Architecture remote-access cases, capture the affected team, office, approximate start time, and whether file transfers are interrupted.\n\nCoordinate a supervised test window with the customer contact. Record gateway observations in the ticket before proposing a configuration change.",
      "created_at": "2026-09-10T15:30:00Z",
      "updated_at": "2026-09-15T13:45:00Z"
    },
    {
      "id": 3,
      "company_id": null,
      "site_id": 5,
      "contact_id": null,
      "asset_id": null,
      "title": "Branch practice DNS verification",
      "body": "At Branch practice, compare internal and external lookups from two workstations. Record the resolver in use and repeat the checks after any approved network change.\n\nIf name resolution is intermittent, capture the failed name and time of the attempt before escalating.",
      "created_at": "2026-09-12T10:15:00Z",
      "updated_at": "2026-09-14T17:10:00Z"
    },
    {
